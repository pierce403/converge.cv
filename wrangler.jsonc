{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "converge-cv",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-15",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "converge.cv",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/xmtp-history",
      "/api/xmtp-history/*",
      "/api/xmtp",
      "/api/xmtp/*"
    ],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "invocation_logs": false,
    },
  },
  "env": {
    "preview": {
      "name": "converge-cv-preview",
      "workers_dev": true,
      "routes": [],
    },
  },
}
